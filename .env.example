# --- MultiHopper -----------------------------------------------------------
# Leave MH_API_KEY empty to run in DEMO MODE (in-memory simulator, no chain).
# Devnet keys (mh_test_...) come from https://devnet.multihopper.com/developer/dashboard
# Production keys (mh_live_...) from https://multihopper.com/developer/dashboard
MH_API_KEY=
# https://devnet.multihopper.com for devnet, https://multihopper.com for mainnet.
MH_API_BASE=https://devnet.multihopper.com

# --- Solana ----------------------------------------------------------------
# Server-side RPC used to broadcast signed transactions. Use a paid RPC
# (Helius, Triton, QuickNode) in production; the public endpoint rate-limits.
SOLANA_RPC_URL=https://api.devnet.solana.com
# "devnet" or "mainnet" - controls token mints and explorer links.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Sessions --------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=
